# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_...

# API Integrations
SMARTLEAD_API_KEY=smartlead_api_key
LEADMAGIC_API_KEY=leadmagic_api_key
PROSPEO_API_KEY=prospeo_api_key
AIRSCALE_API_KEY=airscale_api_key
FULLENRICH_API_KEY=fullenrich_api_key
FULLENRICH_WEBHOOK_TOKEN=replace_with_a_separate_long_random_token

# Internal API
INTERNAL_API_TOKEN=replace_with_a_long_random_token
PUBLIC_API_BASE_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional. Must also be listed in Auth redirect URLs.
INVITE_REDIRECT_URL=http://localhost:5173/update-password

# Optional SmartLead tuning
SMARTLEAD_BASE_URL=https://server.smartlead.ai/api/v1
SMARTLEAD_TIMEOUT_SECONDS=30
SMARTLEAD_MAX_RETRIES=3
SMARTLEAD_IMPORT_LIMIT=1000

# Optional phone-enrichment tuning
LEADMAGIC_BASE_URL=https://api.leadmagic.io
PROSPEO_BASE_URL=https://api.prospeo.io
AIRSCALE_BASE_URL=https://api.airscale.io
FULLENRICH_BASE_URL=https://app.fullenrich.com/api/v2
PHONE_PROVIDER_TIMEOUT_SECONDS=30
PHONE_PROVIDER_MAX_RETRIES=2
PHONE_ENRICHMENT_CONCURRENCY=5
PHONE_ENRICHMENT_RECONCILE_SECONDS=300

# Optional Sheriff / Perplexity Agent API (table CRUD works without this)
PERPLEXITY_API_KEY=
SHERIFF_MODEL=openai/gpt-5.4-mini
SHERIFF_TIMEOUT_SECONDS=60
SHERIFF_CONCURRENCY=3
